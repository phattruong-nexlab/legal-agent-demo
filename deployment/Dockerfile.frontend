# =========================
# Frontend (Streamlit) image
# Build context = repo root
# =========================

# -------- 1. Builder stage --------
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# fe.txt does `-r base.txt`, so the whole requirements/ dir must be present.
COPY requirements/ /app/requirements/
RUN pip install --no-cache-dir -r requirements/fe.txt


# -------- 2. Runtime stage --------
FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

COPY frontend/main.py /app/main.py
COPY frontend/.streamlit /app/.streamlit
COPY deployment/entrypoint-fe.sh /app/entrypoint-fe.sh

RUN chmod +x /app/entrypoint-fe.sh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint-fe.sh"]
